# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client

# Google Gemini — free tier, no billing required. Get a key at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Used by scripts/seed-demo.ts (optional overrides)
DEMO_EMAIL=demo@studypilot.app
DEMO_PASSWORD=StudyPilotDemo123!

# Optional: your deployed URL, used in a couple of server-side links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
